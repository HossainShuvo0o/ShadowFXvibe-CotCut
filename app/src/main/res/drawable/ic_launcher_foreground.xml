            <gradient
                android:startX="66"
                android:startY="54"
                android:endX="85"
                android:endY="76"
                android:type="linear">
                <item android:color="#A855F7" android:offset="0.0" />
                <item android:color="#EC4899" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Glowing dot accent representing typography point / accent -->
    <path
        android:pathData="M48,74 A4,4 0 1,1 48,74.01"
        android:fillColor="#00F0FF" />
